---
import { Image } from "astro:assets";
import PageHeader from "../PageHeader.astro";
import { localizedPath, type Locale } from "../../text/ui";
import { getImage } from "../../lib/images";
import { getJournal, cmsImage } from "../../lib/microcms";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const journal = await getJournal();
const head = {
  ja: { title: "ジャーナル", subtitle: "人・街・コーヒーをめぐる読み物。" },
  en: { title: "Journal", subtitle: "Stories of people, towns and coffee." },
}[locale];
---

<PageHeader eyebrow="JOURNAL" title={head.title} subtitle={head.subtitle} />

<div class="container">
  <ul class="journal-grid">
    {
      journal.map((j) => {
        const local = getImage(`journal/${j.slug}`);
        return (
          <li class="journal-card">
            <a href={localizedPath(`/journal/${j.slug}`, locale)}>
              {j.thumbnailUrl ? (
                <img class="journal-card__img" src={cmsImage(j.thumbnailUrl, 800)} alt="" loading="lazy" />
              ) : local ? (
                <Image class="journal-card__img" src={local} alt="" widths={[400, 800]} sizes="(max-width: 720px) 100vw, 33vw" />
              ) : (
                <div class="journal-card__img ph ph--wide" aria-hidden="true">{j.category}</div>
              )}
              <span class="journal-card__cat">{j.category}</span>
              <span class="journal-card__date">{j.date}</span>
              <p class="journal-card__title">{j.title[locale]}</p>
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .journal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5) var(--space-4); }
  .journal-card a { display: flex; flex-direction: column; gap: 0.4rem; }
  .journal-card__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: var(--space-1); }
  .journal-card__cat { font-size: 0.7rem; letter-spacing: 0.16em; color: var(--color-accent); }
  .journal-card__date { font-size: var(--fs-small); color: var(--color-ink-soft); }
  .journal-card__title { font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.7; }
  @media (max-width: 720px) { .journal-grid { grid-template-columns: 1fr; } }
</style>
