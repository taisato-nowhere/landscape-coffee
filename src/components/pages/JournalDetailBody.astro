---
import { Image } from "astro:assets";
import { localizedPath, type Locale } from "../../text/ui";
import { getImage } from "../../lib/images";
import { type Article, cmsImage } from "../../lib/microcms";

interface Props {
  locale: Locale;
  item: Article;
}
const { locale, item } = Astro.props;
const local = getImage(`journal/${item.slug}`);
const back = locale === "ja" ? "ジャーナル一覧へ" : "All journal";
const bodyHtml = item.body[locale] || item.body.ja;
const placeholder =
  locale === "ja"
    ? "（本文は準備中です。microCMS で本文を入力すると、ここに表示されます。）"
    : "(Article body coming soon — enter it in microCMS to show it here.)";
---

<article class="container container--narrow journal-article">
  <p class="journal-article__meta"><span class="journal-article__cat">{item.category}</span><span>{item.date}</span></p>
  <h1 class="journal-article__title">{item.title[locale]}</h1>
  {
    item.thumbnailUrl ? (
      <img class="journal-article__img" src={cmsImage(item.thumbnailUrl, 1280)} alt="" />
    ) : local ? (
      <Image class="journal-article__img" src={local} alt="" widths={[760, 1280]} sizes="(max-width: 800px) 100vw, 760px" />
    ) : null
  }
  {
    bodyHtml ? (
      <div class="journal-article__body" set:html={bodyHtml} />
    ) : (
      <p class="journal-article__body">{placeholder}</p>
    )
  }
  <a class="link-more" href={localizedPath("/journal", locale)}>← {back}</a>
</article>

<style>
  .journal-article { padding-top: var(--space-5); }
  .journal-article__meta { display: flex; gap: var(--space-2); font-size: var(--fs-small); color: var(--color-ink-soft); }
  .journal-article__cat { color: var(--color-accent); letter-spacing: 0.16em; }
  .journal-article__title { font-family: var(--font-serif); font-size: var(--fs-h1); font-weight: 500; margin: var(--space-2) 0 var(--space-4); }
  .journal-article__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: var(--space-4); }
  .journal-article__body { line-height: 2.1; margin-bottom: var(--space-4); }
</style>
