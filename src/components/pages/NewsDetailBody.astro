---
import { Image } from "astro:assets";
import { localizedPath, type Locale } from "../../text/ui";
import { type NewsItem } from "../../contents/content";
import { getImage } from "../../lib/images";

interface Props {
  locale: Locale;
  item: NewsItem;
}
const { locale, item } = Astro.props;
const img = getImage(`news/${item.slug}`);
const back = locale === "ja" ? "ニュース一覧へ" : "All news";
const body =
  locale === "ja"
    ? "（本文は準備中です。公開時に microCMS から配信されます。）"
    : "(Article body coming soon — delivered from microCMS at launch.)";
---

<article class="container container--narrow news-article">
  <p class="news-article__meta"><span>{item.date}</span><span class="news-article__cat">{item.category}</span></p>
  <h1 class="news-article__title">{item.title[locale]}</h1>
  {
    img && (
      <Image class="news-article__img" src={img} alt="" widths={[760, 1280]} sizes="(max-width: 800px) 100vw, 760px" />
    )
  }
  <p class="news-article__body">{body}</p>
  <a class="link-more" href={localizedPath("/news", locale)}>← {back}</a>
</article>

<style>
  .news-article { padding-top: var(--space-5); }
  .news-article__meta { display: flex; gap: var(--space-2); font-size: var(--fs-small); color: var(--color-ink-soft); }
  .news-article__cat { color: var(--color-accent); letter-spacing: 0.12em; }
  .news-article__title { font-family: var(--font-serif); font-size: var(--fs-h1); font-weight: 500; margin: var(--space-2) 0 var(--space-4); }
  .news-article__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: var(--space-4); }
  .news-article__body { line-height: 2.1; margin-bottom: var(--space-4); }
</style>
