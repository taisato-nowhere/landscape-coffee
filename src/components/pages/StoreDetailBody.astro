---
import { Image } from "astro:assets";
import { useTranslations, localizedPath, type Locale } from "../../text/ui";
import { type Store } from "../../contents/content";
import { getImage } from "../../lib/images";
import Illustration from "../Illustration.astro";

interface Props {
  locale: Locale;
  store: Store;
}
const { locale, store } = Astro.props;

// 店舗ごとの手描きモチーフ（海沿い=sea / 街=town / 山=mountain）
const motif = {
  sakaide: "sea",
  takamatsu: "sea",
  motomiya: "town",
  takayama: "mountain",
}[store.slug] as "sea" | "town" | "mountain" | undefined;
const t = useTranslations(locale);
const img = getImage(`stores/${store.slug}`);
const open = store.status === "open";

// 仮の店舗詳細（後で microCMS に差し替え）
const details: Record<string, { hours: string; address: Record<Locale, string>; tel: string; parking: Record<Locale, string> }> = {
  sakaide: {
    hours: "11:00–19:00 / 月曜定休",
    address: { ja: "香川県坂出市（詳細は準備中）", en: "Sakaide, Kagawa (details coming)" },
    tel: "—",
    parking: { ja: "近隣駐車場あり", en: "Nearby parking available" },
  },
  motomiya: {
    hours: "11:00–19:00（夜営業：金・土）/ 定休日準備中",
    address: { ja: "福島県本宮市・JR本宮駅徒歩1分", en: "1 min from JR Motomiya Sta., Fukushima" },
    tel: "—",
    parking: { ja: "店舗駐車場3台＋本宮駅前無料駐車場", en: "3 spaces + free station parking" },
  },
};
const d = details[store.slug];
const label = {
  ja: { hours: "営業時間", address: "所在地", tel: "電話", parking: "駐車場", menu: "メニュー", soon: "近日オープン予定。最新情報はニュース・SNSでお知らせします。", back: "店舗一覧へ" },
  en: { hours: "Hours", address: "Address", tel: "Tel", parking: "Parking", menu: "Menu", soon: "Opening soon. Follow our news and social for updates.", back: "All stores" },
}[locale];
---

<section class="store-detail">
  {
    img ? (
      <Image class="store-detail__hero" src={img} alt="" widths={[768, 1280, 2000]} sizes="100vw" />
    ) : (
      <div class="store-detail__hero ph ph--wide" aria-hidden="true">{store.nameEn}</div>
    )
  }

  <div class="container container--narrow">
    <div class="store-detail__head">
      <span class="store-detail__code">{store.code}</span>
      <div>
        <h1 class="store-detail__name">{store.nameEn}</h1>
        <p class="store-detail__area">{store.area[locale]}</p>
      </div>
      <span class={`badge ${open ? "badge--open" : "badge--coming"}`}>
        {open ? t("status.open") : t("status.coming")}
      </span>
    </div>

    {motif && (
      <div class="illust-divider"><Illustration name={motif} width={140} /></div>
    )}

    {
      open && d ? (
        <dl class="store-detail__info">
          <div><dt>{label.hours}</dt><dd>{d.hours}</dd></div>
          <div><dt>{label.address}</dt><dd>{d.address[locale]}</dd></div>
          <div><dt>{label.tel}</dt><dd>{d.tel}</dd></div>
          <div><dt>{label.parking}</dt><dd>{d.parking[locale]}</dd></div>
        </dl>
      ) : (
        <p class="store-detail__soon">{label.soon}</p>
      )
    }

    {
      open && (
        <section class="store-detail__menu">
          <h2>{label.menu}</h2>
          <div class="menu-cols">
            <div><h3>LUNCH</h3><p>{locale === "ja" ? "ワンプレートランチ（準備中）" : "One-plate lunch (coming)"}</p></div>
            <div><h3>CAFE</h3><p>{locale === "ja" ? "スペシャルティコーヒー・スイーツ" : "Specialty coffee & sweets"}</p></div>
            <div><h3>BAR</h3><p>{locale === "ja" ? "福島の地酒・夜の一杯" : "Local sake & evening drinks"}</p></div>
          </div>
        </section>
      )
    }

    <a class="link-more" href={localizedPath("/stores", locale)}>← {label.back}</a>
  </div>
</section>

<style>
  .store-detail__hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: var(--space-5);
  }
  .store-detail__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }
  .store-detail__code {
    font-family: var(--font-en-display);
    font-size: clamp(3rem, 9vw, 5rem);
    font-weight: 700;
    line-height: 0.9;
  }
  .store-detail__name {
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .store-detail__area { color: var(--color-ink-soft); font-size: var(--fs-small); }
  .badge { margin-left: auto; font-size: 0.7rem; letter-spacing: 0.16em; padding: 0.2rem 0.6rem; border: 1px solid currentColor; border-radius: 999px; }
  .badge--open { color: var(--color-accent); }
  .badge--coming { color: var(--color-ink-soft); }
  .store-detail__info {
    margin: var(--space-4) 0;
    display: grid;
    gap: var(--space-2);
  }
  .store-detail__info div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-2);
    padding-block: 0.4rem;
    border-bottom: 1px dotted var(--color-line);
  }
  .store-detail__info dt { color: var(--color-ink-soft); font-size: var(--fs-small); }
  .store-detail__soon {
    margin: var(--space-4) 0;
    padding: var(--space-3);
    background: var(--color-bg-alt);
    text-align: center;
  }
  .store-detail__menu { margin: var(--space-5) 0; }
  .store-detail__menu h2 { font-size: var(--fs-h2); font-weight: 600; margin-bottom: var(--space-3); }
  .menu-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  .menu-cols h3 { letter-spacing: 0.16em; color: var(--color-accent); margin-bottom: 0.4rem; }
  @media (max-width: 680px) { .menu-cols { grid-template-columns: 1fr; } }
</style>
