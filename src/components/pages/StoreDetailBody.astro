---
import { Image } from "astro:assets";
import { useTranslations, localizedPath, withBase, type Locale } from "../../text/ui";
import { getStoreImage } from "../../lib/images";
import { type StoreEntry, cmsImage } from "../../lib/microcms";
import goodsIllustrationUrl from "../../assets/images/brand07/07_goods_illust.svg?url";
import Illustration from "../Illustration.astro";

interface Props {
  locale: Locale;
  store: StoreEntry;
}
const { locale, store } = Astro.props;

const t = useTranslations(locale);
const local = getStoreImage(store.slug);
const isMotomiya = store.slug === "motomiya";
const motomiyaVideoSrc = withBase("/media/motomiya-hero.mp4?v=20260910-trim");
const motomiyaPosterSrc = withBase("/media/motomiya-hero-poster.jpg");
const open = store.status === "open";
const mapUrl = store.mapUrl.trim();
const instagramUrl = store.instagramUrl.trim();

const hasInfo =
  open && Boolean(store.hours || store.address[locale] || store.tel || store.parking[locale]);
const bodyHtml = store.body[locale] || store.body.ja;

const label = {
  ja: { hours: "営業時間", address: "所在地", tel: "電話", parking: "駐車場", instagram: "Instagram", soon: "近日オープン予定。最新情報はニュース・SNSでお知らせします。", back: "店舗一覧へ" },
  en: { hours: "Hours", address: "Address", tel: "Tel", parking: "Parking", instagram: "Instagram", soon: "Opening soon. Follow our news and social for updates.", back: "All stores" },
}[locale];
---

<section class="store-detail">
  {
    isMotomiya ? (
      <div class="store-detail__hero store-detail__hero--video" aria-hidden="true">
        <img
          class="store-detail__poster"
          src={motomiyaPosterSrc}
          alt=""
          width="1920"
          height="1080"
          loading="eager"
          decoding="async"
        />
        <video
          class="store-detail__video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={motomiyaPosterSrc}
        >
          <source src={motomiyaVideoSrc} type='video/mp4; codecs="avc1.640029"' />
        </video>
      </div>
    ) : store.thumbnailUrl ? (
      <img class="store-detail__hero" src={cmsImage(store.thumbnailUrl, 2000)} alt="" />
    ) : local ? (
      <Image class="store-detail__hero" src={local} alt="" widths={[768, 1280, 2000]} sizes="100vw" />
    ) : (
      <div class="store-detail__hero ph ph--wide" aria-hidden="true">{store.nameEn}</div>
    )
  }

  <div class="container container--narrow">
    <div class="store-detail__head">
      <span class="store-detail__code">{store.code}</span>
      <div>
        <h1 class="store-detail__name">{store.nameEn}</h1>
        <p class="store-detail__area">{store.area[locale]}</p>
      </div>
      <span class={`badge ${open ? "badge--open" : "badge--coming"}`}>
        {open ? t("status.open") : t("status.coming")}
      </span>
    </div>

    {isMotomiya ? (
      <div class="illust-divider illust-divider--goods" aria-hidden="true">
        <img class="store-detail__goods-illustration" src={goodsIllustrationUrl} alt="" loading="lazy" decoding="async" />
      </div>
    ) : store.motif && (
      <div class="illust-divider"><Illustration name={store.motif} width={140} /></div>
    )}

    {
      hasInfo ? (
        <dl class="store-detail__info">
          {store.hours && <div><dt>{label.hours}</dt><dd class="store-detail__hours">{store.hours}</dd></div>}
          {store.address[locale] && (
            <div>
              <dt>{label.address}</dt>
              <dd>
                {mapUrl ? (
                  <a class="store-detail__map" href={mapUrl} target="_blank" rel="noopener">
                    {store.address[locale]} ↗
                  </a>
                ) : store.address[locale]}
              </dd>
            </div>
          )}
          {store.tel && <div><dt>{label.tel}</dt><dd>{store.tel}</dd></div>}
          {store.parking[locale] && <div><dt>{label.parking}</dt><dd>{store.parking[locale]}</dd></div>}
        </dl>
      ) : !open ? (
        <p class="store-detail__soon">{label.soon}</p>
      ) : null
    }

    {
      instagramUrl && (
        <p class="store-detail__sns">
          <a href={instagramUrl} target="_blank" rel="noopener">
            {label.instagram} →
          </a>
        </p>
      )
    }

    {bodyHtml && <div class="store-detail__body" set:html={bodyHtml} />}

    <a class="link-more" href={localizedPath("/stores", locale)}>← {label.back}</a>
  </div>
</section>

<style>
  .store-detail__hero {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: var(--space-5);
  }
  .store-detail__hero--video {
    position: relative;
    overflow: hidden;
    background: #171612;
  }
  .store-detail__poster,
  .store-detail__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .store-detail__video { z-index: 1; }
  .store-detail__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }
  .store-detail__code {
    font-family: var(--font-en-display);
    font-size: clamp(3rem, 9vw, 5rem);
    font-weight: 700;
    line-height: 0.9;
  }
  .store-detail__name {
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .store-detail__area { color: var(--color-ink-soft); font-size: var(--fs-small); }
  .badge { margin-left: auto; font-size: 0.7rem; letter-spacing: 0.16em; padding: 0.2rem 0.6rem; border: 1px solid currentColor; border-radius: 999px; }
  .badge--open { color: var(--color-accent); }
  .badge--coming { color: var(--color-ink-soft); }
  .store-detail__info {
    margin: var(--space-4) 0;
    display: grid;
    gap: var(--space-2);
  }
  .store-detail__info div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-2);
    padding-block: 0.4rem;
    border-bottom: 1px dotted var(--color-line);
  }
  .store-detail__info dt { color: var(--color-ink-soft); font-size: var(--fs-small); }
  .store-detail__hours { white-space: pre-line; }
  .store-detail__map {
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 0.24em;
  }
  .illust-divider--goods {
    padding-block: var(--space-3);
  }
  .store-detail__goods-illustration {
    display: block;
    width: min(280px, 70vw);
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
  }
  .store-detail__sns {
    margin: calc(var(--space-4) * -0.4) 0 var(--space-4);
  }
  .store-detail__sns a {
    color: var(--color-accent);
    font-family: var(--font-en-display);
    font-size: var(--fs-small);
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }
  .store-detail__soon {
    margin: var(--space-4) 0;
    padding: var(--space-3);
    background: var(--color-bg-alt);
    text-align: center;
  }
  .store-detail__body { margin: var(--space-4) 0; line-height: 2.1; }
  .store-detail__body :global(h2) { font-size: var(--fs-h2); font-weight: 600; margin: var(--space-4) 0 var(--space-2); }
  .store-detail__body :global(h3) { letter-spacing: 0.12em; color: var(--color-accent); margin: var(--space-3) 0 0.4rem; }
  .store-detail__body :global(img) { width: 100%; height: auto; margin: var(--space-2) 0; }
  .store-detail__body :global(p) { margin-bottom: var(--space-2); }

  @media (prefers-reduced-motion: reduce) {
    .store-detail__video { display: none; }
  }
</style>
