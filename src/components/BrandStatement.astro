---
import { Image } from "astro:assets";
import { useTranslations, localizedPath, type Locale } from "../text/ui";
import { getImage } from "../lib/images";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const body = t("brand.body").split("\n");
const photos = ["brand07/sakaide-interior-counter", "brand07/sakaide-pour", "brand07/takayama-riverside"]
  .map((key) => getImage(key))
  .filter(Boolean);
---

<section class="section brand">
  <div class="container brand__inner">
    <div class="brand__copy">
      <p class="eyebrow">ABOUT LANDSCAPE</p>
      <p class="brand__tagline">{t("hero.subtitle")}</p>
      <div class="brand__body">
        {body.map((line) => <p>{line}</p>)}
      </div>
      <a class="link-more" href={localizedPath("/about", locale)}>
        {t("brand.more")} →
      </a>
    </div>

    {
      photos.length > 0 && (
        <div class="brand__photos" aria-hidden="true">
          {photos.map((photo, i) => (
            <Image
              class:list={["brand__photo", `brand__photo--${i + 1}`]}
              src={photo}
              alt=""
              widths={[320, 520, 760]}
              sizes="(max-width: 900px) 33vw, 22vw"
            />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .brand__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: var(--space-5);
    align-items: center;
  }
  .brand__copy {
    display: grid;
    gap: var(--space-3);
  }
  .brand__tagline {
    font-family: var(--font-en-display);
    font-size: var(--fs-small);
    letter-spacing: 1px;
    color: var(--color-accent);
  }
  .brand__body {
    display: grid;
    gap: var(--space-2);
    max-width: 38rem;
    color: var(--color-ink);
    line-height: 2.05;
  }
  .brand__photos {
    display: grid;
    grid-template-columns: 1.05fr 0.78fr;
    grid-template-rows: 0.9fr 0.7fr;
    gap: var(--space-2);
    min-height: clamp(22rem, 44vw, 34rem);
  }
  .brand__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.02);
  }
  .brand__photo--1 {
    grid-row: 1 / 3;
  }
  .brand__photo--2 {
    aspect-ratio: 4 / 3;
  }
  .brand__photo--3 {
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 900px) {
    .brand__inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .brand__photos {
      min-height: 0;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: none;
    }
    .brand__photo,
    .brand__photo--1,
    .brand__photo--2,
    .brand__photo--3 {
      grid-row: auto;
      aspect-ratio: 4 / 5;
    }
  }

  @media (max-width: 560px) {
    .brand__photos {
      gap: 0.45rem;
    }
  }
</style>
