---
// 手描き風の線画イラスト（年輪ロゴと同じ手描きトーン）。currentColor で線色を継承。
// name で motif を選択。装飾用途なので aria-hidden。
interface Props {
  name: "mountain" | "sea" | "cup" | "town" | "beans" | "ring" | "stump" | "coffee";
  width?: number;
  class?: string;
}
const { name, width = 120, class: cls } = Astro.props;
const common = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.6",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const;
---

<span class:list={["illust", cls]} style={`width:${width}px`} aria-hidden="true">
  {
    name === "mountain" && (
      <svg viewBox="0 0 120 56" {...common}>
        <circle cx="92" cy="16" r="7" />
        <path d="M2 50 C16 49 22 47 30 40 C36 35 40 22 47 22 C53 22 57 33 63 40 C68 46 74 49 84 47 C92 45 99 47 104 49 C110 51 115 50 118 50" />
        <path d="M30 40 C34 41 40 41 44 39" opacity="0.6" />
        <path d="M63 40 C68 42 74 42 80 40" opacity="0.6" />
      </svg>
    )
  }
  {
    name === "sea" && (
      <svg viewBox="0 0 120 56" {...common}>
        <path d="M70 20 L70 33 L104 33 C102 38 96 40 92 40 L74 40 C70 40 67 37 66 33 Z" />
        <path d="M78 20 L94 20 L92 33" />
        <path d="M2 44 C8 41 12 41 18 44 C24 47 28 47 34 44 C40 41 44 41 50 44" opacity="0.85" />
        <path d="M2 51 C9 48 14 48 20 51 C26 54 31 54 37 51 C43 48 48 48 54 51 C60 54 66 54 72 51" opacity="0.65" />
      </svg>
    )
  }
  {
    name === "cup" && (
      <svg viewBox="0 0 80 64" {...common}>
        <path d="M16 26 L60 26 L56 50 C55 55 51 58 46 58 L30 58 C25 58 21 55 20 50 Z" />
        <path d="M60 30 C70 30 72 42 62 44" />
        <path d="M32 8 C28 12 36 14 32 18" opacity="0.7" />
        <path d="M44 6 C40 11 48 13 44 18" opacity="0.7" />
      </svg>
    )
  }
  {
    name === "town" && (
      <svg viewBox="0 0 120 56" {...common}>
        <path d="M4 52 L4 34 L18 24 L32 34 L32 52" />
        <path d="M32 52 L32 30 L46 22 L60 30 L60 52" />
        <path d="M60 52 L60 36 L74 28 L88 36 L88 52" />
        <path d="M88 52 L88 26 L100 18 L112 26 L112 52" />
        <path d="M2 52 L118 52" opacity="0.7" />
        <path d="M48 40 L52 40 M52 40 L52 52" opacity="0.6" />
      </svg>
    )
  }
  {
    name === "beans" && (
      <svg viewBox="0 0 80 56" {...common}>
        <ellipse cx="30" cy="26" rx="16" ry="11" transform="rotate(-24 30 26)" />
        <path d="M22 32 C28 24 32 22 38 18" transform="rotate(-24 30 26)" />
        <ellipse cx="54" cy="36" rx="13" ry="9" transform="rotate(-20 54 36)" />
        <path d="M48 41 C53 34 56 32 61 29" transform="rotate(-20 54 36)" />
      </svg>
    )
  }
  {
    name === "ring" && (
      <svg viewBox="0 0 64 64" {...common} stroke-width="2">
        <path d="M32 8 C50 8 58 22 56 34 C54 48 42 58 30 56 C16 54 8 42 10 30 C12 18 20 10 32 10" />
        <ellipse cx="32" cy="33" rx="17" ry="16" />
        <ellipse cx="32" cy="33" rx="10" ry="9" />
        <ellipse cx="32.5" cy="33" rx="4.5" ry="4" />
      </svg>
    )
  }
  {
    name === "stump" && (
      <svg viewBox="0 0 110 100" {...common} stroke-width="1.8">
        {/* 切り株の年輪（手描き・少し歪んだ同心円） */}
        <path d="M55 7 C73 6 90 21 95 42 C99 60 91 81 69 90 C50 98 24 90 16 67 C9 47 17 23 37 12 C43 8 48 7 55 7 Z" />
        <path d="M53 18 C68 18 83 30 83 47 C83 63 70 77 51 76 C34 75 23 61 24 45 C25 30 39 19 53 18 Z" opacity="0.92" />
        <path d="M52 30 C63 29 73 38 72 50 C71 61 60 68 49 65 C38 62 33 53 36 43 C38 35 44 31 52 30 Z" opacity="0.85" />
        <path d="M51 41 C58 40 63 46 60 52 C57 58 49 58 45 53 C42 49 45 42 51 41 Z" opacity="0.8" />
        {/* 中心と、外へ伸びる割れ */}
        <path d="M53 8 C51 18 55 26 52 41" opacity="0.45" />
        <path d="M60 51 C72 60 82 66 95 69" opacity="0.4" />
      </svg>
    )
  }
  {
    name === "coffee" && (
      <svg viewBox="0 0 86 88" {...common} stroke-width="1.8">
        {/* 湯気 */}
        <path d="M36 20 C32 15 40 12 36 6" opacity="0.7" />
        <path d="M48 22 C44 17 52 14 48 8" opacity="0.7" />
        {/* ドリッパー（円錐） */}
        <path d="M21 38 L63 38 L52 60 L32 60 Z" />
        <path d="M28 38 L42 60 M56 38 L42 60" opacity="0.4" />
        {/* カップ */}
        <path d="M30 62 L54 62 L51 78 C50 81 47 83 44 83 L40 83 C37 83 34 81 33 78 Z" />
        <path d="M54 66 C63 65 64 76 55 77" />
      </svg>
    )
  }
</span>

<style>
  .illust {
    display: inline-block;
    color: var(--color-accent);
    line-height: 0;
  }
  .illust svg {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
