---
import { Image } from "astro:assets";
import { useTranslations, localizedPath, type Locale } from "../text/ui";
import { getImage } from "../lib/images";
import { getJournal, cmsImage } from "../lib/microcms";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const journal = (await getJournal()).slice(0, 3);
---

<section class="section journal">
  <div class="container">
    <div class="section-head">
      <h2>{t("journal.title")}</h2>
      <a class="link-more" href={localizedPath("/journal", locale)}>
        {t("journal.more")} →
      </a>
    </div>

    <ul class="journal__grid">
      {
        journal.map((j) => (
          <li class="journal__card">
            <a href={localizedPath(`/journal/${j.slug}`, locale)}>
              {(() => {
                const local = getImage(`journal/${j.slug}`);
                if (j.thumbnailUrl) {
                  return <img class="journal__media journal__img" src={cmsImage(j.thumbnailUrl, 800)} alt="" loading="lazy" />;
                }
                return local ? (
                  <Image class="journal__media journal__img" src={local} alt="" widths={[400, 800]} sizes="(max-width: 720px) 100vw, 33vw" />
                ) : (
                  <div class="journal__media ph ph--wide" aria-hidden="true">
                    {j.category}
                  </div>
                );
              })()}
              <span class="journal__cat">{j.category}</span>
              <span class="journal__date">{j.date}</span>
              <p class="journal__title">{j.title[locale]}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .journal__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .journal__card a {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .journal__media {
    margin-bottom: var(--space-1);
  }
  .journal__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .journal__cat {
    font-family: var(--font-en-display);
    font-size: var(--fs-small);
    letter-spacing: 1px;
    text-transform: lowercase;
    color: var(--color-accent);
  }
  .journal__date {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }
  .journal__title {
    font-size: var(--fs-body);
    line-height: 1.8;
  }

  @media (max-width: 720px) {
    .journal__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
