---
// ヒーロー：複数の写真をゆっくり動かしながら（Ken Burns）クロスフェードで切り替える。
// Berth Coffee 参考。画像は src/assets/images/hero/*.jpg を順に表示。
import { Image } from "astro:assets";
import { useTranslations, type Locale } from "../text/ui";
import { getImages } from "../lib/images";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// ヒーローのスライド：src/assets/images/hero/ 配下を自動収集。
// （main を先頭に、以降はファイル名順。画像を足す/減らすだけで増減できる）
const slides = getImages("hero");
---

<section class="hero">
  <div class="hero__media" data-hero-slides>
    {
      slides.length > 0 ? (
        slides.map((img, i) => (
          <Image
            class:list={["hero__slide", { "is-active": i === 0 }]}
            src={img}
            alt=""
            widths={[768, 1280, 2000]}
            sizes="100vw"
            loading={i === 0 ? "eager" : "lazy"}
          />
        ))
      ) : (
        <div class="ph ph--wide" role="img" aria-label="Kominka cafe interior">
          古民家の店内写真（プレースホルダ）
        </div>
      )
    }
  </div>

  <div class="container hero__overlay">
    <p class="eyebrow hero__eyebrow">LANDSCAPE COFFEE</p>
    <h1 class="hero__title">{t("hero.title")}</h1>
    <p class="hero__subtitle">{t("hero.subtitle")}</p>
  </div>

  <span class="hero__scroll" aria-hidden="true">{t("hero.scroll")}</span>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
  }
  .hero__media {
    position: relative;
    aspect-ratio: 16 / 10;
    min-height: 60vh;
    overflow: hidden;
    background: var(--color-bg-alt);
  }
  @media (min-width: 768px) {
    .hero__media {
      aspect-ratio: 16 / 8;
      min-height: 72vh;
    }
  }
  /* 各スライドは重ねて配置し、opacity でクロスフェード */
  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /* ゆっくりフェード（イーズで滑らかに） */
    transition: opacity 3s ease-in-out;
    will-change: opacity, transform;
    transform: translateZ(0);
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  /* Ken Burns：全スライドを“同じタイムライン”で常にゆっくりズーム。
     切替時も拡大率が一致するので、カクつき（拡大率の飛び）が起きない。 */
  @media (prefers-reduced-motion: no-preference) {
    .hero__slide {
      animation: hero-zoom 28s ease-in-out infinite alternate;
    }
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.12);
    }
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    color: var(--color-bg);
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.35);
  }
  .hero__eyebrow {
    color: color-mix(in srgb, var(--color-bg) 85%, transparent);
  }
  .hero__title {
    font-family: var(--font-serif);
    font-size: var(--fs-hero);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: var(--lh-tight);
    /* 和文は句読点でのみ改行（語中での不自然な折り返しを防ぐ） */
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  .hero__subtitle {
    font-size: 1rem;
    letter-spacing: 0.12em;
  }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-3);
    transform: translateX(-50%);
    writing-mode: vertical-rl;
    font-size: var(--fs-small);
    letter-spacing: 0.3em;
    color: var(--color-bg);
  }
</style>

<script>
  // 一定間隔で is-active を次のスライドへ送り、クロスフェード＋Ken Burns を回す。
  const box = document.querySelector<HTMLElement>("[data-hero-slides]");
  const slides = box ? Array.from(box.querySelectorAll<HTMLElement>(".hero__slide")) : [];
  if (slides.length > 1) {
    let i = 0;
    const INTERVAL = 6500; // 表示時間（フェード2.4s込み）
    setInterval(() => {
      slides[i].classList.remove("is-active");
      i = (i + 1) % slides.length;
      slides[i].classList.add("is-active");
    }, INTERVAL);
  }
</script>
