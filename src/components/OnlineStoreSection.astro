---
// ONLINE STORE：叩き案 C の物販（LANDSCAPE / 37 / 07 / 21 BLEND）。
// 後で Shopify Storefront API の商品に差し替え。
import { Image } from "astro:assets";
import {
  useTranslations,
  localizedPath,
  type Locale,
} from "../text/ui";
import { products, yen } from "../contents/content";
import { getImage } from "../lib/images";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section shop">
  <div class="container">
    <div class="section-head">
      <h2>{t("shop.title")}</h2>
      <a class="link-more" href={localizedPath("/shop", locale)}>
        {t("shop.more")} →
      </a>
    </div>

    <ul class="shop__grid">
      {
        products.map((pr) => (
          <li class="product">
            <a href={localizedPath(`/shop/${pr.handle}`, locale)}>
              {(() => {
                const img = getImage(`products/${pr.handle}`);
                return img ? (
                  <Image class="product__media product__img" src={img} alt="" widths={[300, 600]} sizes="(max-width: 900px) 50vw, 25vw" />
                ) : (
                  <div class="product__media ph ph--square" aria-hidden="true">
                    <span class="product__bag">{pr.name[locale]}</span>
                  </div>
                );
              })()}
              <p class="product__name">{pr.name[locale]}</p>
              <p class="product__meta">
                <span>{pr.weight}</span>
                <span class="product__price">{yen(pr.price)}</span>
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .shop__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }
  .product__media {
    background: linear-gradient(160deg, #efe7d8, #d9cdb6);
    display: grid;
    place-items: center;
    margin-bottom: var(--space-2);
  }
  .product__img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: none;
  }
  .product__bag {
    font-size: var(--fs-small);
    letter-spacing: 0.1em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-soft);
    padding: 0.6rem 0.8rem;
    background: var(--color-surface);
  }
  .product__name {
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .product__meta {
    display: flex;
    justify-content: space-between;
    margin-top: 0.2rem;
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }
  .product__price {
    color: var(--color-ink);
  }

  @media (max-width: 900px) {
    .shop__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
