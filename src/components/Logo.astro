---
// 公式ロゴ（納品PNGから生成した透過版）を読み込む。
//   - landscape-coffee-horizontal.png （横組み：マーク左＋ワードマーク右）
//   - landscape-coffee-stacked.png    （縦組み：マーク上＋ワードマーク下）
// reverse=true で暗い背景用に白へ反転（透過背景前提）。
import { withBase } from "../i18n/ui";
interface Props {
  variant?: "horizontal" | "stacked";
  reverse?: boolean;
  height?: number;
}
const { variant = "horizontal", reverse = false, height = 36 } = Astro.props;
const src = withBase(`/logo/landscape-coffee-${variant}.png`);
---

<img
  class:list={["logo", { "logo--reverse": reverse }]}
  src={src}
  alt="LANDSCAPE COFFEE"
  height={height}
  style={`height:${height}px`}
  decoding="async"
/>

<style>
  .logo {
    display: block;
    width: auto;
  }
  /* 透過背景の黒ロゴを、暗い背景用に白へ */
  .logo--reverse {
    filter: invert(1) brightness(2);
  }
</style>
