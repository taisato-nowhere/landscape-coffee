---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase, type Locale } from "../text/ui";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** ファーストビューに重ねる透明ヘッダー（トップページ等） */
  transparentHeader?: boolean;
}
const { locale, title, description, transparentHeader = false } = Astro.props;
const fullTitle =
  title === "LANDSCAPE COFFEE" ? title : `${title} | LANDSCAPE COFFEE`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <link rel="icon" href={withBase("/favicon.png")} type="image/png" />
    <script is:inline>
      // reveal用：描画前に html.js-reveal を付けて隠す（FOUC防止 / 動き低減設定は尊重）
      try {
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("js-reveal");
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <Header locale={locale} transparent={transparentHeader} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // スクロールで“ふわっと”表示。隣り合う要素は少しずつ遅らせてカスケード。
      const mq = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (!mq.matches) {
        const sel = [
          ".hero__media", ".hero__overlay", ".brand__inner", ".section-head", ".landscape",
          ".news__item", ".journal__card", ".product", ".illust-divider", ".ring-divider",
          ".about__hero", ".about__section", ".store-card", ".store-detail__hero",
          ".store-detail__info", ".store-detail__menu", ".news-row",
          ".journal-card", ".news-article", ".journal-article", ".contact-form",
        ].join(",");
        const els = Array.from(document.querySelectorAll<HTMLElement>(sel));
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: "0px 0px -6% 0px" }
        );
        for (const el of els) {
          const sibs = el.parentElement
            ? Array.from(el.parentElement.children).filter((c) => c.matches(sel))
            : [el];
          const i = sibs.indexOf(el);
          if (i > 0) el.style.transitionDelay = Math.min(i, 4) * 80 + "ms";
          io.observe(el);
        }
      }
    </script>
  </body>
</html>
