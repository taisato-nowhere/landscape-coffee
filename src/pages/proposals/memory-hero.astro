---
import { Image } from "astro:assets";
import Logo from "../../components/Logo.astro";
import { getImage } from "../../lib/images";
import "../../styles/global.css";

const photos = [
  ["brand07/mountain-river", "山と川の景色"],
  ["brand07/coffee-beans", "コーヒー豆"],
  ["brand07/kominka-front", "古民家外観"],
  ["brand07/leaves", "木の葉"],
  ["brand07/river-wide", "川沿い"],
  ["brand07/coffee-chiffon", "コーヒーと菓子"],
].map(([key, alt]) => ({ img: getImage(key), alt })).filter((item) => item.img);

const variantB = [
  ["brand07/window-family", "窓越しの街"],
  ["brand07/green-hill", "緑の山"],
  ["brand07/station", "駅前の景色"],
  ["brand07/women-field", "自然の中の人"],
  ["brand07/river-bend", "川の曲線"],
  ["brand07/street-wide", "街の道"],
].map(([key, alt]) => ({ img: getImage(key), alt })).filter((item) => item.img);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hero Memory Photo Proposals | LANDSCAPE COFFEE</title>
  </head>
  <body class="proposal-body">
    <main>
      <section class="proposal proposal--print">
        <div class="proposal__logo"><Logo variant="horizontal" height={88} /></div>
        <p class="proposal__caption">Memories, ring by ring.</p>
        <div class="print-grid" aria-label="写真案 A">
          {photos.map((photo, i) => (
            <figure class:list={["print", `print--${i + 1}`]}>
              <Image src={photo.img} alt={photo.alt} widths={[300, 520, 760]} sizes="46vw" />
            </figure>
          ))}
        </div>
      </section>

      <section class="proposal proposal--album">
        <div class="proposal__logo"><Logo variant="horizontal" height={78} /></div>
        <div class="album-board" aria-label="写真案 B">
          {variantB.map((photo, i) => (
            <figure class:list={["album", `album--${i + 1}`]}>
              <Image src={photo.img} alt={photo.alt} widths={[300, 520, 760]} sizes="46vw" />
            </figure>
          ))}
        </div>
      </section>

      <section class="proposal proposal--tape">
        <div class="proposal__logo"><Logo variant="horizontal" height={78} /></div>
        <div class="tape-board" aria-label="写真案 C">
          {[...photos.slice(0, 3), ...variantB.slice(0, 3)].map((photo, i) => (
            <figure class:list={["tape", `tape--${i + 1}`]}>
              <span aria-hidden="true" />
              <Image src={photo.img} alt={photo.alt} widths={[300, 520, 760]} sizes="42vw" />
            </figure>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  .proposal-body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .proposal {
    min-height: 100svh;
    display: grid;
    align-content: start;
    justify-items: center;
    padding: clamp(5rem, 12vh, 8rem) var(--gutter) clamp(4rem, 10vh, 7rem);
    border-bottom: 1px solid var(--color-line);
  }

  .proposal__logo {
    width: min(58vw, 280px);
  }

  .proposal__logo :global(.logo) {
    width: 100%;
    height: auto !important;
  }

  .proposal__caption {
    margin: clamp(2rem, 7vh, 3.8rem) 0 1.1rem;
    font-family: var(--font-serif);
    font-size: 0.78rem;
    letter-spacing: 0.09em;
  }

  .print-grid,
  .album-board,
  .tape-board {
    width: min(86vw, 390px);
  }

  .print-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.65rem, 2.2vw, 0.9rem);
  }

  .print,
  .album,
  .tape {
    margin: 0;
    position: relative;
  }

  .print {
    padding: clamp(0.45rem, 1.8vw, 0.72rem) clamp(0.45rem, 1.8vw, 0.72rem)
      clamp(1.05rem, 3vw, 1.45rem);
    background: color-mix(in srgb, var(--color-surface) 96%, white);
    box-shadow:
      0 1px 0 rgba(34, 34, 34, 0.06),
      0 12px 30px rgba(34, 34, 34, 0.08);
  }

  .print::after {
    content: "";
    position: absolute;
    left: 16%;
    right: 16%;
    bottom: 0.46rem;
    height: 1px;
    background: color-mix(in srgb, var(--color-line) 72%, transparent);
  }

  .print img,
  .album img,
  .tape img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(0.96);
  }

  .print img {
    aspect-ratio: 1 / 1;
  }

  .print--2,
  .print--5 {
    transform: translateY(1.2rem);
  }

  .print--3 {
    transform: translateY(-0.4rem);
  }

  .album-board {
    margin-top: clamp(4rem, 13vh, 7rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background:
      linear-gradient(var(--color-line), var(--color-line)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--color-line), var(--color-line)) 0 33.333% / 100% 1px no-repeat,
      linear-gradient(var(--color-line), var(--color-line)) 0 66.666% / 100% 1px no-repeat;
    border: 1px solid var(--color-line);
  }

  .album {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-surface);
  }

  .album img {
    padding: clamp(0.28rem, 1vw, 0.4rem);
    background: var(--color-surface);
  }

  .tape-board {
    margin-top: clamp(4rem, 13vh, 7rem);
    min-height: 560px;
    position: relative;
  }

  .tape {
    position: absolute;
    width: min(42vw, 175px);
    padding: 0.38rem;
    background: var(--color-surface);
    box-shadow: 0 14px 34px rgba(34, 34, 34, 0.1);
    opacity: 0;
    --rotate: 0deg;
    animation:
      memory-photo-in 1.45s cubic-bezier(0.16, 1, 0.3, 1) both,
      memory-photo-drift 7.5s ease-in-out infinite alternate;
  }

  .tape img {
    aspect-ratio: 4 / 5;
  }

  .tape span {
    position: absolute;
    z-index: 2;
    top: -0.42rem;
    left: 50%;
    width: 42%;
    height: 1rem;
    transform: translateX(-50%) rotate(-2deg);
    background: color-mix(in srgb, var(--color-sand) 64%, white);
    opacity: 0.78;
  }

  .tape--1 { left: 0; top: 0; --rotate: -2deg; animation-delay: 0.1s, 1.55s; }
  .tape--2 { right: 0.2rem; top: 2.4rem; --rotate: 1.8deg; animation-delay: 0.34s, 1.78s; }
  .tape--3 { left: 22%; top: 11.4rem; --rotate: 0.8deg; animation-delay: 0.58s, 2.02s; }
  .tape--4 { right: 0; top: 20.5rem; --rotate: -1.2deg; animation-delay: 0.82s, 2.26s; }
  .tape--5 { left: 0.4rem; top: 27.4rem; --rotate: 1.4deg; animation-delay: 1.06s, 2.5s; }
  .tape--6 { left: 48%; top: 35rem; --rotate: -1.7deg; animation-delay: 1.3s, 2.74s; }

  @keyframes memory-photo-in {
    from {
      opacity: 0;
      filter: blur(8px) saturate(0.76);
    }

    to {
      opacity: 1;
      filter: blur(0) saturate(1);
    }
  }

  @keyframes memory-photo-drift {
    from {
      transform: translate3d(-1px, 0, 0) rotate(calc(var(--rotate) - 0.28deg));
    }

    to {
      transform: translate3d(2px, -5px, 0) rotate(calc(var(--rotate) + 0.28deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tape {
      opacity: 1;
      animation: none;
      transform: rotate(var(--rotate));
    }
  }

  @media (min-width: 800px) {
    .proposal {
      padding-top: 7rem;
    }

    .print-grid,
    .album-board {
      width: min(58vw, 620px);
    }

    .tape-board {
      width: min(92vw, 1240px);
      min-height: 780px;
      margin-top: clamp(5.5rem, 12vh, 8rem);
    }

    .tape {
      width: clamp(150px, 17vw, 245px);
    }

    .tape span {
      height: 1.08rem;
    }

    .tape--1 {
      left: 4%;
      top: 4rem;
      --rotate: -2.4deg;
    }

    .tape--2 {
      right: 7%;
      top: 5.5rem;
      --rotate: 1.6deg;
    }

    .tape--3 {
      left: 36%;
      top: 13rem;
      --rotate: 0.7deg;
    }

    .tape--4 {
      right: 20%;
      top: 26rem;
      --rotate: -1.1deg;
    }

    .tape--5 {
      left: 10%;
      top: 32rem;
      --rotate: 1.3deg;
    }

    .tape--6 {
      left: 51%;
      top: 41rem;
      --rotate: -1.6deg;
    }
  }

  @media (min-width: 1180px) {
    .proposal--tape .proposal__logo {
      width: 300px;
    }

    .tape-board {
      width: min(94vw, 1420px);
      min-height: 820px;
    }

    .tape--1 {
      left: 2%;
      top: 2rem;
    }

    .tape--2 {
      right: 4%;
      top: 4rem;
    }

    .tape--3 {
      left: 39%;
      top: 11rem;
    }

    .tape--4 {
      right: 19%;
      top: 28rem;
    }

    .tape--5 {
      left: 12%;
      top: 34rem;
    }

    .tape--6 {
      left: 55%;
      top: 43rem;
    }
  }
</style>
