---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StoreDetailBody from "../../../components/pages/StoreDetailBody.astro";
import { getStores } from "../../../lib/microcms";

export async function getStaticPaths() {
  const stores = await getStores();
  return stores.map((s) => ({ params: { slug: s.slug }, props: { store: s } }));
}

const locale = "en" as const;
const { store } = Astro.props;
---

<BaseLayout locale={locale} title={`${store.nameEn} ${store.code}`} description={`LANDSCAPE COFFEE ${store.nameEn} (${store.area[locale]}).`}>
  <StoreDetailBody locale={locale} store={store} />
</BaseLayout>
