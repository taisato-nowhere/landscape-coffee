---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import JournalDetailBody from "../../../components/pages/JournalDetailBody.astro";
import { getJournal } from "../../../lib/microcms";

export async function getStaticPaths() {
  const journal = await getJournal();
  return journal.map((j) => ({ params: { slug: j.slug }, props: { item: j } }));
}

const locale = "en" as const;
const { item } = Astro.props;
---

<BaseLayout locale={locale} title={item.title[locale]} description={item.title[locale]}>
  <JournalDetailBody locale={locale} item={item} />
</BaseLayout>
