---
// English top (/en)
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import BrandStatement from "../../components/BrandStatement.astro";
import LandscapesSection from "../../components/LandscapesSection.astro";
import NewsSection from "../../components/NewsSection.astro";
import JournalSection from "../../components/JournalSection.astro";
import OnlineStoreSection from "../../components/OnlineStoreSection.astro";
import Illustration from "../../components/Illustration.astro";

const locale = "en" as const;
---

<BaseLayout
  locale={locale}
  title="LANDSCAPE COFFEE"
  description="LANDSCAPE COFFEE — a brand delivering specialty coffee into everyday life. A place where memories meet."
  transparentHeader
>
  <Hero locale={locale} />
  <BrandStatement locale={locale} />
  <div class="illust-divider"><Illustration name="stump" width={150} /></div>
  <LandscapesSection locale={locale} />
  <NewsSection locale={locale} />
  <JournalSection locale={locale} />
  <div class="illust-divider"><Illustration name="coffee" width={78} /></div>
  <OnlineStoreSection locale={locale} />
</BaseLayout>
