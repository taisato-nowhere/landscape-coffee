# microCMS 連携用の鍵（このファイルをコピーして .env を作る）。
#   cp .env.example .env
# .env は Git にコミットされません（.gitignore 済み）。本番(GitHub Actions)は
# リポジトリの Settings → Secrets and variables → Actions に同名で登録します。
#
# 値は microCMS 管理画面で確認:
#   - サービスドメイン: URL の "https://XXXX.microcms.io" の XXXX 部分
#   - APIキー: 「サービス設定 → APIキー」の値（読み取り(GET)権限でOK）

MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=your-api-key
